<article class="post page" data-first-image>
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
  </header>
  <div class="prose post-content" lang="<%= page_lang(page) %>">
    <%- page.content %>
  </div>
</article>
<% if (page.comments === true) { %><%- partial('_partial/comments') %><% } %>
