<% const cat = page.categories && page.categories.length ? page.categories.toArray()[0] : null; %>
<article class="post<%= page.layout === 'photo-diary' ? ' photo-diary' : '' %>" data-first-image>
  <header class="post-header">
    <p class="meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'MMM D, YYYY') %></time><% if (cat) { %> · <a href="<%= url_for(cat.path) %>"><%= cat.name %></a><% } %> · <%= t('reading_time', reading_minutes(page)) %></p>
    <h1 class="post-title"><%= page.title %></h1>
  </header>
  <div class="prose post-content" lang="<%= page_lang(page) %>">
    <%- page.content %>
  </div>
  <footer class="post-footer">
    <% if (page.tags && page.tags.length) { %>
    <ul class="chips" aria-label="<%= t('tagged') %>">
      <% page.tags.each(function (tag) { %><li><a class="chip" href="<%= url_for(tag.path) %>">#<%= tag.name %></a></li><% }) %>
    </ul>
    <% } %>
    <nav class="post-nav" aria-label="More posts">
      <% if (page.prev) { %><a class="post-nav-link newer" href="<%= url_for(page.prev.path) %>"><span><%- icon('back') %><%= t('next_post') %></span><strong><%= page.prev.title %></strong></a><% } else { %><span></span><% } %>
      <% if (page.next) { %><a class="post-nav-link older" href="<%= url_for(page.next.path) %>"><span><%= t('prev_post') %><%- icon('next') %></span><strong><%= page.next.title %></strong></a><% } %>
    </nav>
  </footer>
</article>
<%- partial('_partial/comments') %>
